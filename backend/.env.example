# MongoDB Connection URI (Atlas Cluster or local instance)
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=AtmCluster
DATABASE_NAME=atm_kiosk

# Gemini API Keys for Dynamic Key Rotator & Failover (get keys from Google AI Studio)
GEMINI_API_KEY_1=AIzaSy_YOUR_FIRST_GEMINI_KEY
GEMINI_API_KEY_2=AIzaSy_YOUR_SECOND_GEMINI_KEY
GEMINI_API_KEY_3=AIzaSy_YOUR_THIRD_GEMINI_KEY

# Security & Session Settings
SECRET_KEY=your-super-secret-atm-kiosk-jwt-token-key-change-in-production
ALGORITHM=HS256
ATM_SESSION_EXPIRY_SECONDS=180
GEMINI_FAILOVER_COOLDOWN_SECONDS=60
